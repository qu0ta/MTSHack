# Copy to .env locally; never commit the filled file.
# Set all model/API values before importing ML (uvicorn --env-file .env).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b
# Optional separate keys; ML uses LLM_API_KEY if absent.
# EMBEDDER_API_KEY=
# RERANKER_API_KEY=

# Absolute path to the private Markdown directory or knowledge-base.zip.
KB_PATH=
# DATA_DIR=data
# Bundled, unchanged ML version; may become ml.rag_api after team integration.
ML_MODULE=app.ml.rag_api
TEMPERATURE=0
MAX_TOKENS=1500
AI_REQUEST_TIMEOUT_SECONDS=55
AI_MAX_CONCURRENCY=2
RAG_BUDGET_SECONDS=45
RAG_MAX_HISTORY=12
RAG_RETRIEVAL_TURNS=6
